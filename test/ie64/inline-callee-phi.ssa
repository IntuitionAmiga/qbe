# A callee whose conditional expression made a phi is inlined: the phi is
# copied with its blocks, and the caller keeps no call.
function w $sign(w %x) {
@start
	%c =w csltw %x, 0
	jnz %c, @neg, @pos
@neg
	jmp @join
@pos
	jmp @join
@join
	%r =w phi @neg 0, @pos 1
	ret %r
}

export function w $use(w %a, w %b) {
@start
	%x =w call $sign(w %a)
	%y =w call $sign(w %b)
	%s =w add %x, %y
	ret %s
}
