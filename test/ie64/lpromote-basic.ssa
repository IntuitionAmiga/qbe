# The matrix kernel uses separate pointer arguments. Their byte ranges may overlap.
export function $acc(l %c, l %a, l %b, w %n) {
@start
	jmp @head0
@head0
	%j =w phi @start 0, @tail %j1
	%cj =w cultw %j, %n
	jnz %cj, @pre, @done
@pre
	%o =l extuw %j
	%o4 =l mul %o, 4
	%p =l add %c, %o4
	storew 0, %p
	jmp @head
@head
	%k =w phi @pre 0, @body %k1
	%ck =w cultw %k, %n
	jnz %ck, @body, @tail
@body
	%ko =l extuw %k
	%ko2 =l mul %ko, 2
	%pa =l add %a, %ko2
	%pb =l add %b, %ko2
	%x =w loadsh %pa
	%y =w loadsh %pb
	%m =w mul %x, %y
	%old =w loadsw %p
	%new =w add %old, %m
	storew %new, %p
	%k1 =w add %k, 1
	jmp @head
@tail
	%j1 =w add %j, 1
	jmp @head0
@done
	ret
}

# The 64-bit global accumulator needs no preheader access.
export function w $global(w %n) {
@start
	jmp @head
@head
	%k =w phi @start 0, @body %k1
	%ck =w cultw %k, %n
	jnz %ck, @body, @done
@body
	%xl =l extuw %k
	%old =l loadl $total
	%new =l add %old, %xl
	storel %new, $total
	%k1 =w add %k, 1
	jmp @head
@done
	ret 0
}

# The read at offset 0 is disjoint. Sink the final store onto the loop's
# exit edge because another path also reaches the exit block.
export function w $exitjoin(l %c, w %n, w %s) {
@start
	%p =l add %c, 8
	jnz %s, @pre, @join
@pre
	storew 1, %p
	jmp @head
@head
	%k =w phi @pre 0, @body %k1
	%ck =w cultw %k, %n
	jnz %ck, @body, @join
@body
	%x =w loadsh %c
	%old =w loadsw %p
	%new =w add %old, %x
	storew %new, %p
	%k1 =w add %k, 1
	jmp @head
@join
	%r =w loadsw %p
	ret %r
}
