export function l $spill_copy(l %a, l %b, l %c, l %d, l %e, l %f, l %g, l %h, l %i, l %j) {
@start
	call $clobber()
	%ab =l add %a, %b
	%cd =l add %c, %d
	%ef =l add %e, %f
	%gh =l add %g, %h
	%ij =l add %i, %j
	%abcd =l add %ab, %cd
	%efgh =l add %ef, %gh
	%x =l add %abcd, %efgh
	%r =l add %x, %ij
	ret %r
}

function $clobber() {
@start
	ret
}
