# The env pseudo-argument travels in r28 and must not displace a real
# argument: the six integer registers stay available to the ordinary
# sequence, and a seventh argument still goes to the stack.

function l $envonly(env %e) {
@start
	ret %e
}

function l $envfull(env %e, l %a, l %b, l %c, l %d, l %f, l %g, l %h) {
@start
	%s =l add %e, %a
	%t =l add %s, %g
	%u =l add %t, %h
	ret %u
}

export function l $callenv(l %x) {
@start
	%r =l call $envonly(env %x)
	%s =l call $envfull(env %r, l 1, l 2, l 3, l 4, l 5, l 6, l 7)
	ret %s
}
