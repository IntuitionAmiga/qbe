export function l $loop(s %x, s %y, w %count) {
@start
	ie64fmovsc 0
@head
	%left =w phi @start %count, @again %next
	%flags =l ie64fmovsr
	jnz %left, @again, @done
@again
	%unused =s div %x, %y
	%next =w sub %left, 1
	jmp @head
@done
	ret %flags
}

export function l $switch_case(l %index, l %p, s %x, s %y) {
@start
	ie64fmovsc 0
	%unused =s div %x, %y
	%value =d loadv %p
	storevd %value, %p
	switch %index, @miss, @zero, @one, @read, @read
@miss
	ret 100
@zero
	ret 101
@one
	ret 102
@read
	%flags =l ie64fmovsr
	ret %flags
}

export function l $switch_default(l %index, s %x, s %y) {
@start
	ie64fmovsc 0
	%unused =s div %x, %y
	switch %index, @read, @zero, @one
@zero
	ret 100
@one
	ret 101
@read
	%minus =s neg %y
	%flags =l ie64fmovsr
	ret %flags
}

export function l $switch_backedge(l %index, s %x, s %y, w %count) {
@start
	ie64fmovsc 0
@head
	%left =w phi @start %count, @again %next
	%flags =l ie64fmovsr
	jnz %left, @again, @done
@again
	%unused =s div %x, %y
	%next =w sub %left, 1
	switch %index, @out, @out, @out, @head
@out
	ret 100
@done
	ret %flags
}

export function l $switch_phi(l %index, l %p, s %x, s %y, w %take) {
@start
	ie64fmovsc 0
	jnz %take, @dispatch, @other
@dispatch
	%unused =s div %x, %y
	switch %index, @miss, @hit, @miss, @hit
@other
	jmp @hit
@hit
	%value =s phi @dispatch s_-1, @other %y
	%flags =l ie64fmovsr
	storevs %value, %p
	ret %flags
@miss
	ret 100
}

export function l $switch_cleared(l %index, s %x, s %y) {
@start
	%unused =s div %x, %y
	switch %index, @miss, @zero, @read
@miss
	ret 100
@zero
	ret 101
@read
	ie64fmovsc 0
	%flags =l ie64fmovsr
	ret %flags
}
