export function l $unused_div(s %x, s %y) {
@start
	ie64fmovsc 0
	%unused =s div %x, %y
	%flags =l ie64fmovsr
	ret %flags
}

export function l $sticky(s %x, s %y) {
@start
	ie64fmovsc 0
	%unused =s div %x, %y
	%replaced =s neg %x
	%last =s neg %y
	%flags =l ie64fmovsr
	ret %flags
}

export function l $cleared(s %x, s %y) {
@start
	%unused =s div %x, %y
	ie64fmovsc 0
	%flags =l ie64fmovsr
	ret %flags
}

export function $unobserved(s %x, s %y) {
@start
	%unused =s div %x, %y
	ret
}

export function l $incoming(s %x, s %y) {
@start
	%unused =s div %x, %y
	%flags =l call $observe()
	ret %flags
}

export function l $edge(s %x, s %y, w %take) {
@start
	ie64fmovsc 0
	jnz %take, @divide, @replace
@divide
	%unused =s div %x, %y
	jmp @read
@replace
	%minus =s neg %x
@read
	%flags =l ie64fmovsr
	ret %flags
}

export function l $pair_pressure(l %p, d %x) {
@start
	%keep0 =d loadv %p
	%keep1 =d loadv %p
	%keep2 =d loadv %p
	%keep3 =d loadv %p
	%keep4 =d loadv %p
	%keep5 =d loadv %p
	%sin =d ie64dsincos %x
	%cos =d ie64dcosresult %sin
	%flags =l ie64fmovsr
	storevd %sin, %p
	storevd %cos, %p
	storevd %keep0, %p
	storevd %keep1, %p
	storevd %keep2, %p
	storevd %keep3, %p
	storevd %keep4, %p
	storevd %keep5, %p
	ret %flags
}

export function l $transport(l %p, d %x, w %bits) {
@start
	%sin =d ie64dsin %x
	%load =d loadv %p
	%cast =s cast %bits
	storevd %load, %p
	storevs %cast, %p
	storevs s_-1, %p
	%flags =l ie64fmovsr
	ret %flags
}

export function l $call_argument(s %x) {
@start
	%unused =s div %x, %x
	%flags =l call $observe_scalar(s s_-1)
	ret %flags
}

