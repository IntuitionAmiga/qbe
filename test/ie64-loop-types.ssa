export function $dot(l %acc, l %p, w %n) {
@start
    storew 0, %acc #!2
    jmp @head
@head
    %i =w phi @start 0, @body %next
    %ptr =l phi @start %p, @body %step
    %more =w cultw %i, %n
    jnz %more, @body, @exit
@body
    %value =w loadsh %ptr #!1
    %sum =w loadw %acc #!2
    %total =w add %sum, %value
    storew %total, %acc #!2
    %next =w add %i, 1
    %step =l add %ptr, 2
    jmp @head
@exit
    ret
}
