# A store to untyped allocated memory can change its effective type.
export function $overlap(l %acc, l %p, w %n) {
@start
    storew 0, %acc #!2
    jmp @head
@head
    %i =w phi @start 0, @body %next
    %more =w cultw %i, %n
    jnz %more, @body, @exit
@body
    %sum =w loadw %acc #!2
    %total =w add %sum, 1
    storew %total, %acc #!2
    storeh 42, %p #!1
    %next =w add %i, 1
    jmp @head
@exit
    ret
}
