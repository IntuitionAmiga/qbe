export function w $same(l %left, l %right) {
@entry
    %a =w loadsh %left
    %b =w loadsh %right
    %again =w extsh %b
    %same =w ceqw %a, %again
    ret %same
}

# A caller can already supply the key and consume the search result in
# a later phi. The null test and match share an exit edge to that join.
export function l $continuation(l %node, w %key, w %run, l %fallback) {
@start
    jnz %run, @pre, @join
@pre
    jmp @head
@head
    %p =l phi @pre %node, @next %advance
    %valid =w cnel %p, 0
    jnz %valid, @check, @exit
@check
    %data =l add %p, 8
    %byte =w loadub %data
    %ne =w cnew %byte, %key
    jnz %ne, @next, @exit
@next
    %advance =l loadl %p
    jmp @head
@exit
    jmp @join
@join
    %result =l phi @exit %p, @start %fallback
    ret %result
}
