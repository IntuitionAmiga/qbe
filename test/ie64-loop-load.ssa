export function l $find(l %node, l %key) {
@start
    jmp @head
@head
    %p =l phi @start %node, @next %advance
    %valid =w cnel %p, 0
    jnz %valid, @check, @exit
@check
    %data =l add %p, 8
    %item =w loadsh %data
    %byte =w and %item, 255
    %k =w loadsh %key
    %ne =w cnew %byte, %k
    jnz %ne, @next, @exit
@next
    %advance =l loadl %p
    jmp @head
@exit
    ret %p
}
