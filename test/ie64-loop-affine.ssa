export function w $affine(w %bound, w %stride, w %offset, l %p) {
@entry
    jmp @head
@head
    %i =w phi @entry 0, @body %next
    %sum =w phi @entry 0, @body %acc
    %run =w cultw %i, %bound
    jnz %run, @body, @exit
@body
    %mul =w mul %i, %stride
    %idx =w add %mul, %offset
    %wide =l extsw %idx
    %addr =l add %p, %wide
    %read =w loadub %addr
    %acc =w add %sum, %read
    %next =w add %i, 1
    jmp @head
@exit
    ret %sum
}
